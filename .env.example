# App
APP_NAME=Job Hunt OS
# Local Postgres (run scripts/setup_local_postgres.sh), or sqlite:///./jobhunt.db for a zero-setup file DB.
DATABASE_URL=postgresql+psycopg://rohanroy@localhost:5432/jobhunt
# Optional: run pytest against Postgres instead of throwaway SQLite files.
# TEST_DATABASE_URL=postgresql+psycopg://rohanroy@localhost:5432/jobhunt_test
APP_BASE_URL=http://localhost:8000
CRON_SECRET=change-me
# Accounts. SECRET_KEY encrypts the API keys people save in Settings; keep it stable and private.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALLOW_SIGNUP=true
SESSION_DAYS=30
# Leave blank to set the Secure cookie flag automatically on HTTPS requests.
SESSION_COOKIE_SECURE=

# Every account saves its own API keys in Settings. The *_API_KEY and APIFY_API_TOKEN values in this
# file are only copied (encrypted) into the FIRST account when it signs up; nobody else uses them.

# LLM provider: litellm | openrouter | openai | anthropic | gemini | mock
# `litellm` is gateway mode (preferred): every worker's model is configured in Settings → AI Models and every
# request goes through the LiteLLM proxy. See README "LiteLLM & AI Model Configuration".
LLM_PROVIDER=openrouter

# LiteLLM gateway. These are bootstrap values; each account can change them in Settings → AI Models → LiteLLM.
LITELLM_BASE_URL=
# Copied (encrypted) into the FIRST account only, like the provider keys below.
LITELLM_API_KEY=
# Seed the default tiers with LiteLLM model names (aliases). Examples, not requirements:
# LITELLM_TIER_FAST=local-fast
# LITELLM_TIER_PRIMARY=local-reasoning
# LITELLM_TIER_DEEP=local-deep
# An auto router that already exists in LiteLLM (Job Hunt OS then routes to it without managing it).
# LITELLM_AUTO_ROUTER_MODEL=
# Answers for a worker whose tier has no model yet.
LITELLM_DEFAULT_MODEL=
# How managed models and the auto router are applied inside LiteLLM: admin_api (needs STORE_MODEL_IN_DB=True on the
# proxy), config_file (writes only LITELLM_MANAGED_CONFIG_PATH; the proxy's config must `include:` it), or disabled.
LITELLM_SYNC_MODE=disabled
LITELLM_MANAGED_CONFIG_PATH=
# Optional: the proxy's own config, only read to check that it includes the managed file.
LITELLM_CONFIG_PATH=
# Optional: restarts the proxy after the managed file changes (split like a shell command, not run by a shell).
LITELLM_RESTART_COMMAND=
LITELLM_RESTART_WAIT_SECONDS=60
LITELLM_ADMIN_TIMEOUT_SECONDS=15
# The server's Ollama, listed by "Add local Ollama model" (the app only ever fetches this URL).
OLLAMA_BASE_URL=http://localhost:11434
# How long workers cache their resolved model configuration; an Apply clears it immediately in its own process.
AI_CONFIG_CACHE_SECONDS=30
# Imports the auto router's tier and cause from LiteLLM spend logs into Monitoring (minutes, 0 disables).
LITELLM_TELEMETRY_INTERVAL_MINUTES=10

# OpenRouter (recommended low-cost/default path)
# `openrouter/free` dynamically chooses from currently available free models.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
# Optional per-stage overrides. Leave blank to inherit OPENROUTER_MODEL.
OPENROUTER_MODEL_RANK=
OPENROUTER_MODEL_TAILOR=
OPENROUTER_MODEL_REVIEW=
OPENROUTER_MODEL_FOLLOWUP=
# Provider-independent stage models (any provider). A model saved in Settings still wins. In LiteLLM gateway mode
# they seed the matching workers' model assignments the first time AI model configuration is created.
RANK_MODEL=
TAILOR_MODEL=
REVIEW_MODEL=
FOLLOWUP_MODEL=
# Optional comma-separated model fallbacks, e.g. vendor/model:free,openrouter/free
OPENROUTER_FALLBACK_MODELS=
# Safety switch: prevents accidentally calling a paid OpenRouter model.
OPENROUTER_REQUIRE_FREE=true
OPENROUTER_MAX_TOKENS=5000
# Every provider call: timeout and SDK retries (workers also retry with backoff)
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1

# LLM monitoring: metadata and token counts for every request; prompt text only with LLM_PROMPT_DEBUG=true.
LLM_TELEMETRY_ENABLED=true
LLM_TELEMETRY_RETENTION_DAYS=90
LLM_PROMPT_DEBUG=false
# Model prices and context windows; blank uses app/model_catalog.json
MODEL_CATALOG_FILE=
# Optional attribution headers recommended by OpenRouter.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Job Hunt OS

# Google ADK / Vertex AI Agent Engine (used by job_hunt_agent)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_AGENT_MODEL=gemini-2.5-flash

# Direct OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Direct Anthropic (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Direct Gemini (Gemini API key from Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Job discovery: Apify is the primary Hunter source.
# Create a token in Apify Console -> Settings -> Integrations.
APIFY_API_TOKEN=
APIFY_ACTOR_ID=openclawai/job-board-scraper
APIFY_DATASET_LIMIT=5000

# Hunter actors. The primary actor searches several boards in one run; the others are per-board
# fallbacks, used when you ask for them and when a primary run fails.
APIFY_PRIMARY_JOB_ACTOR=openclawai/job-board-scraper
APIFY_LINKEDIN_ACTOR=thirdwatch/linkedin-jobs-scraper
APIFY_INDEED_ACTOR=crawlerbros/indeed-jobs-scraper
APIFY_GLASSDOOR_ACTOR=crawlerbros/glassdoor-jobs-scraper
APIFY_NAUKRI_ACTOR=crawlerbros/naukri-scraper
# Job Insights research actors (README §14a). Never assumed: an actor runs only with both its ID and its *_INPUT set
# (a JSON input template whose strings may use {company}, {role}, {location} and {limit}); otherwise NOT_CONFIGURED.
APIFY_GLASSDOOR_COMPENSATION_ACTOR=
APIFY_GLASSDOOR_INTERVIEW_ACTOR=
APIFY_GLASSDOOR_REVIEWS_ACTOR=
APIFY_PAYSCALE_ACTOR=
# APIFY_GLASSDOOR_COMPENSATION_INPUT={"companyName": "{company}", "jobTitle": "{role}", "location": "{location}", "maxItems": "{limit}"}
# Start the per-board fallback actors when a multi-board run fails.
APIFY_AUTO_FALLBACK=true
APIFY_REQUEST_TIMEOUT_SECONDS=30
HUNTER_MAX_RUNS_PER_SEARCH=30
APIFY_SYNC_BATCH_SIZE=25

# Safety / workflow
MIN_FIT_SCORE=72
FOLLOWUP_DAYS=5
MAX_JOBS_PER_BATCH=30

# Workflow workers: bounded retries and lease-based crash recovery (PostgreSQL required)
WORKFLOW_MAX_ATTEMPTS=3
WORKFLOW_LEASE_SECONDS=900
WORKFLOW_RETRY_BASE_SECONDS=60
WORKFLOW_RETRY_MAX_SECONDS=3600

# In-app scheduler (starts with FastAPI). Intervals in minutes; 0 disables a job.
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=30
SCHEDULER_LEASE_MINUTES=30
HUNTER_INTERVAL_MINUTES=240
APIFY_SYNC_INTERVAL_MINUTES=5
RANKING_INTERVAL_MINUTES=2
COMPENSATION_INTERVAL_MINUTES=5
APPLICATION_INTERVAL_MINUTES=5
FOLLOWUP_INTERVAL_MINUTES=60
INBOX_INTERVAL_MINUTES=5
ANALYTICS_INTERVAL_MINUTES=60
CLEANUP_INTERVAL_MINUTES=15
# AI Optimization Advisor: processes queued and scheduled analyses (recommendations only)
AI_OPTIMIZATION_INTERVAL_MINUTES=5
RANKING_BATCH_SIZE=20
RANKING_CONCURRENCY=5
# Job Ranker: qualification defaults, retries, leases and automatic re-ranking
MIN_RANKING_CONFIDENCE=0.6
RANKING_MAX_ATTEMPTS=3
RANKING_LEASE_SECONDS=900
RANKING_RETRY_BASE_SECONDS=60
RANKING_RETRY_MAX_SECONDS=3600
RANKING_WAIT_SECONDS=900
RANKING_ENQUEUE_BATCH_SIZE=200
RANKING_MAX_EVIDENCE=40
RANKING_AUTO_RERANK=true
COMPENSATION_BATCH_SIZE=50
# Claude Desktop MCP server (python -m app.mcp): maximum jobs per context request or bulk save
MCP_BULK_TAILOR_LIMIT=10
MCP_BULK_REVIEW_LIMIT=20
MCP_APPLICATION_PAGE_LIMIT=50
MCP_PACKET_DIR=./data/packets
# Enables POST /api/admin/scheduler/{job}/run with header X-Admin-Token. Leave blank to disable.
ADMIN_TOKEN=

# Tests only: a disposable PostgreSQL database (name must contain "test"; it is wiped)
# TEST_DATABASE_URL=postgresql+psycopg://localhost/jobhunt_test

# Job Insights: background research for approved jobs (company, compensation, interviews). README §14a.
JOB_INSIGHTS_ENABLED=true
JOB_INSIGHTS_INTERVAL_MINUTES=5
JOB_INSIGHTS_BATCH_SIZE=5
JOB_INSIGHTS_MAX_CONCURRENCY=2
JOB_INSIGHTS_MAX_ATTEMPTS=3
JOB_INSIGHTS_SOURCE_CONCURRENCY=3
JOB_INSIGHTS_SOURCE_TIMEOUT_SECONDS=120
COMPANY_INSIGHT_TTL_DAYS=30
COMPENSATION_INSIGHT_TTL_DAYS=14
INTERVIEW_INSIGHT_TTL_DAYS=30
# 0 keeps old observations (weighted lower); a number of months drops older ones.
INSIGHT_MAX_OBSERVATION_AGE_MONTHS=0

# Resume extraction V2 (docs/resume-extraction-plan.md): read uploaded PDFs with PDFium, which honours the /ActualText
# some producers (Apple Pages) write for ligature glyphs, so "Kafka" no longer reads "Kaga"; read Word documents with
# their tables and list bullets; find each section's heading and parse from a structure-marked view. Job description
# files are read the same way. Off by default: extraction is exactly as before. This is the server's default: each account can
# switch it in Settings → Resumes ("Read PDF uploads with the new reader") or Running workers → Settings → Resume
# parsing. Restart after changing; only new uploads use it.
RESUME_EXTRACTION_V2=false
# OCR of a flagged PDF's pages (Tesseract on this machine; brew install tesseract / apt install tesseract-ocr), bounded
# so an upload never waits long. Clean PDFs are never OCRed. Without Tesseract, consistent rules alone correct words.
RESUME_OCR_ENABLED=true
RESUME_OCR_MAX_PAGES=4
RESUME_OCR_TIMEOUT_SECONDS=20

# Job description recovery: postings without a usable description are read from their URL in the background.
# HTTP first; headless Chromium only when HTTP finds nothing (python -m playwright install chromium).
JD_FETCH_ENABLED=true
JD_RECOVERY_INTERVAL_MINUTES=2
JD_DESCRIPTION_MIN_CHARACTERS=500
JD_FETCH_BATCH_SIZE=10
JD_FETCH_MAX_CONCURRENCY=2
JD_FETCH_MAX_ATTEMPTS=3
JD_FETCH_LLM_ENABLED=true
PLAYWRIGHT_ENABLED=true
PLAYWRIGHT_BROWSER=chromium
# false opens a visible browser window for local debugging of extraction
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_NAVIGATION_TIMEOUT_SECONDS=45
PLAYWRIGHT_PAGE_TIMEOUT_SECONDS=60
PLAYWRIGHT_MAX_CONCURRENCY=2
PLAYWRIGHT_KEEP_BROWSER_RUNNING=true
PLAYWRIGHT_BLOCK_NONESSENTIAL_RESOURCES=false
PLAYWRIGHT_DEBUG_ARTIFACTS=false

# Application Inbox Agent: read-only Gmail updates for submitted applications (README: Application Inbox Agent).
# A Google OAuth client of type "Web application" with redirect URI {APP_BASE_URL}/api/gmail/oauth/callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=
APPLICATION_INBOX_ENABLED=false
APPLICATION_INBOX_INTERVAL_HOURS=24
GMAIL_INITIAL_LOOKBACK_DAYS=30
GMAIL_SYNC_OVERLAP_HOURS=24
APPLICATION_EMAIL_AUTO_MATCH_THRESHOLD=0.90
APPLICATION_EMAIL_REVIEW_THRESHOLD=0.70
APPLICATION_STAGE_AUTO_UPDATE_THRESHOLD=0.90

# Candidate knowledge retrieval (RAG), README §9d. off | shadow | on; vectors need an EMBEDDER model (LiteLLM gateway)
# and, on PostgreSQL, the pgvector extension. Off by default: the context builders are unchanged.
RAG_RETRIEVAL_MODE=off
RAG_VECTOR_ENABLED=false
RAG_CONTEXT_TOKEN_BUDGET=1200
RAG_INDEX_MINUTES=10

# Langraph settings
AGENT_GRAPHS_ENABLED=true
QUALIFICATION_GRAPH_MODE=shadow

# Application worker (README §10a/§10b, docs/operations/browser-use.md). off | observe | assist | guarded_auto.
# `autonomous` is refused at startup. guarded_auto is auto submit: it submits for accounts that turned Auto submit on
# (Settings → Auto submit), on any board the browser can complete, and stops for you only when something needs you.
# APPLICATION_EXECUTION_MODE=assist
# APPLICATION_MAX_ACTIONS=60
# APPLICATION_TAKEOVER_TTL_MINUTES=15
# Saved ATS logins: sessions you logged in to, and passwords filled only on these exact hosts.
# APPLICATION_AUTH_SESSIONS_ENABLED=false
# APPLICATION_LOGIN_DOMAINS=                 # e.g. acme.wd5.myworkdayjobs.com
# ATS_SESSION_MAX_DAYS=30
# The browser-use backend: Job Hunt OS's own runner on the browser-use Web UI's Python. Local values only.
# BROWSER_USE_WEBUI_ENABLED=true
# BROWSER_USE_PYTHON=/path/to/web-ui/env/bin/python
# BROWSER_USE_WEBUI_PATH=/path/to/web-ui
# BROWSER_USE_WEBUI_URL=http://127.0.0.1:7788/   # health check only; keep it private (it has no authentication)
# BROWSER_USE_TIMEOUT_SECONDS=300
# BROWSER_USE_COMMAND_TIMEOUT_SECONDS=60
# BROWSER_USE_HEADLESS=false                 # show the window so you can take over (local installs)
APPLICATION_EXECUTION_MODE=guarded_auto

# Hybrid domain classification (docs/architecture/domain-classification.md).
# off: the deterministic filter alone. shadow: only recorded, no job changes. on: rules hide only the unambiguous.
# DOMAIN_CLASSIFIER_MODE=off
# Model calls allowed per account per day in shadow mode; 0 means shadow never pays.
# DOMAIN_CLASSIFIER_SHADOW_DAILY_LIMIT=0
